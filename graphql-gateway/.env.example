# ============================================================
# Environment Variables — GraphQL Gateway — Aap ki Rasoi
# Copy this file to graphql-gateway/.env and fill in your real values.
# NEVER commit graphql-gateway/.env to git — it is in .gitignore.
#
# This file is owned by the Gateway team.
# Frontend vars → root .env.example
# Backend vars  → backend/.env.example
# Agent vars    → agents/.env.example
# ============================================================

# --- Backend URL ---
# The FastAPI backend this gateway proxies requests to.
# Development: http://localhost:8000 | Production: your Render service URL
BACKEND_URL=http://localhost:8000

# --- Node environment ---
NODE_ENV=development

# --- Sentry (error reporting) ---
# Get from: Sentry → restaurant-gateway project → Settings → Client Keys → DSN
# Must be the GATEWAY Sentry project — not the frontend or backend project
GATEWAY_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/gateway-project-id

# --- Sentry release tagging ---
# Set automatically by Vercel as VERCEL_GIT_COMMIT_SHA in production — do not set manually there
# Set manually in development only if you need to test Sentry release correlation
GATEWAY_SENTRY_RELEASE=
