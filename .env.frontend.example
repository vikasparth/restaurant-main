# ============================================================
# Environment Variables — Aap ki Rasoi Frontend (Vite + React)
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git — it is in .gitignore.
# ============================================================

# --- Sentry (error tracking) ---
# Get from: Sentry → Project → Settings → Client Keys (DSN)
# Leave empty to disable Sentry in development.
VITE_SENTRY_DSN=
