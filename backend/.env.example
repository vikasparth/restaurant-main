# ============================================================
# Environment Variables — Backend (FastAPI) — Aap ki Rasoi
# Copy this file to backend/.env and fill in your real values.
# NEVER commit backend/.env to git — it is in .gitignore.
#
# This file is owned by the Backend team.
# Frontend vars → root .env.example
# Gateway vars  → graphql-gateway/.env.example
# Agent vars    → agents/.env.example
#
# Config is loaded in backend/core/config.py (pydantic-settings).
# Every var here maps directly to a field in the Settings class.
# ============================================================

# --- Supabase Database ---
# Get from: Supabase → Project Settings → Database → Connection string → URI
# Use the "Direct connection" string (not the pooler) — asyncpg requires it
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Supabase Auth ---
# Get from: Supabase → Project Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-here

# --- CORS ---
# Comma-separated list of allowed frontend origins. Never use * in production.
# Development: http://localhost:5173 | Production: your Vercel URL
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# --- App ---
ENVIRONMENT=development
LOCATION_ID=00000000-0000-0000-0000-000000000001

# --- Resend (email notifications) ---
# Get from: Resend → API Keys
# RESEND_FROM_EMAIL must match a verified domain in Resend (use onboarding@resend.dev for sandbox)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=notifications@yourdomain.com
OWNER_EMAIL=your-notification-email@example.com

# --- Twilio (WhatsApp notifications) ---
# Get from: Twilio → Account Info
# TWILIO_WHATSAPP_FROM: use sandbox number for dev, replace with approved number for production
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP=whatsapp:+1XXXXXXXXXX

# --- Sentry (error reporting) ---
# Get from: Sentry → restaurant-backend project → Settings → Client Keys → DSN
# This DSN reports errors FROM the backend TO Sentry — not the same as SENTRY_AUTH_TOKEN in agents/.env
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/backend-project-id

# --- Git release tagging ---
# Injected automatically by Render as RENDER_GIT_COMMIT — do not set this manually in production
# Set manually in development only if you need to test Sentry release correlation
GIT_COMMIT_SHA=

# --- GitHub (monitoring alerts) ---
# Get from: GitHub → Settings → Developer settings → Personal access tokens
# Required scopes: issues (read & write) on the repo — used to create alert issues
GITHUB_TOKEN=github_pat_your_token_here
GITHUB_REPO=vikasparth/restaurant-main

# --- Render API (log access for monitoring) ---
# Get from: Render → Account Settings → API Keys
# RENDER_SERVICE_ID: Render → Your Service → Settings → Service ID
# RENDER_OWNER_ID: Render → Account Settings → Owner ID
RENDER_API_KEY=rnd_your_key_here
RENDER_SERVICE_ID=srv-your-service-id
RENDER_OWNER_ID=usr-your-owner-id

# --- Internal API security ---
# Shared secret for POST /api/internal/send-reminders (called by Supabase pg_cron via pg_net)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Set the same value as a Supabase config var: app.internal_token
INTERNAL_TOKEN=generate-a-random-secret-here
