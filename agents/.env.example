# ============================================================
# Environment Variables — Agents Package (Aap ki Rasoi)
# Copy this file to agents/.env and fill in your real values.
# NEVER commit agents/.env to git — it is in .gitignore.
#
# This file is owned by the Agents team.
# Frontend vars → root .env.example
# Backend vars  → backend/.env.example
# Gateway vars  → graphql-gateway/.env.example
# ============================================================

# --- Anthropic API ---
# Get from: https://console.anthropic.com → API Keys
# Required for all agents — every agent call goes through the Anthropic SDK
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Sentry (agent queries — not error reporting) ---
# These are used to QUERY the Sentry API for errors, not to report errors from this code.
# Get SENTRY_AUTH_TOKEN from: Sentry → Settings → Auth Tokens → Create New Token (scopes: project:read, event:read)
# Get SENTRY_ORG_SLUG from: Sentry → Settings → General → Organisation Slug
SENTRY_AUTH_TOKEN=sntrys_your_token_here
SENTRY_ORG_SLUG=your-org-slug

# --- Render API (Render Logs Agent — D.3) ---
# Get from: Render → Account Settings → API Keys
# RENDER_SERVICE_ID: Render → Your Service → Settings → Service ID
RENDER_API_KEY=rnd_your_key_here
RENDER_SERVICE_ID=srv-your-service-id

# --- GitHub API (GitHub Agent — D.4) ---
# Get from: GitHub → Settings → Developer settings → Personal access tokens
# Required scopes: repo (read), issues (read)
# Note: this token is scoped to agent read-only access — backend uses a separate token
GITHUB_TOKEN=github_pat_your_token_here
GITHUB_REPO=vikasparth/restaurant-main
