# ============================================================
# Environment Variables — Frontend (React/Vite) — Aap ki Rasoi
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is in .gitignore.
#
# This file is owned by the Frontend team.
# Backend vars  → backend/.env.example
# Gateway vars  → graphql-gateway/.env.example
# Agent vars    → agents/.env.example
# ============================================================

# --- Sentry (error reporting) ---
# Get from: Sentry → restaurant-frontend project → Settings → Client Keys → DSN
# Must be the FRONTEND Sentry project — not the backend or gateway project
VITE_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/frontend-project-id

# --- Sentry release tagging ---
# Set automatically by Vercel as VERCEL_GIT_COMMIT_SHA in production — do not set manually there
# Set manually in development only if you need to test Sentry release correlation
VITE_SENTRY_RELEASE=
