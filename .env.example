# ============================================================
# Environment Variables — Aap ki Rasoi Backend (FastAPI)
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is in .gitignore.
# ============================================================

# --- Supabase Database (direct Postgres connection for asyncpg) ---
# Get from: Supabase → Project Settings → Database → Connection string → URI
# Use the "Direct connection" string (not the pooler)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Supabase Auth (JWT verification for admin routes) ---
# Get from: Supabase → Project Settings → API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-here

# --- CORS ---
# Comma-separated list of allowed frontend origins. Never use * in production.
# Development: http://localhost:5173
# Production: your Vercel URL
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# --- App ---
ENVIRONMENT=development
LOCATION_ID=00000000-0000-0000-0000-000000000001

# --- Resend (email notifications) ---
# Get from: Resend → API Keys
# EMAIL_FROM must match a verified domain in Resend (use sandbox for development)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=notifications@yourdomain.com
OWNER_EMAIL=your-notification-email@example.com

# --- Twilio (WhatsApp notifications) ---
# Get from: Twilio → Account Info
# TWILIO_WHATSAPP_FROM: use sandbox number for dev, replace with approved number for production
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
OWNER_WHATSAPP=whatsapp:+1XXXXXXXXXX

# --- Cron security ---
# Shared secret for POST /api/reservations/send-reminders
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Set the same value in cron-job.org as a custom request header: X-Cron-Secret
CRON_SECRET=generate-a-random-secret-here
